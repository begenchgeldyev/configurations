Host aigent
  HostName 192.168.212.15
  User aigent

# VPS. Some egresses (office LAN, mobile) rate-limit outbound TCP/22: SYNs are
# dropped after a burst of connections, while the host itself stays reachable on
# other ports. sshd therefore also listens on 8022 — always use that port.
# The key ~/.ssh/server is not in the repo; copy it separately.
Host server
  HostName 208.92.227.18
  Port 8022
  User root
  IdentityFile ~/.ssh/server
  IdentitiesOnly yes
