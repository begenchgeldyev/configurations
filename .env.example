# Copy to ~/.env and fill in real values (.env is git-ignored here).
# mise exports these into every activated shell ([env] in .config/mise/config.toml),
# and .config/opencode/opencode.json reads them via {env:...} substitution.

# Synecta Hub (https://llm-hub.synecta.tech/v1)
SYNECTA_API_KEY=

# Claude via kz proxy
ANTHROPIC_API_KEY=

# Jira MCP (projects.synecta.tech personal access token)
JIRA_PERSONAL_TOKEN=

# Figma MCP
FIGMA_API_KEY=
