{
  "$schema": "https://opencode.ai/config.json",
  "model": "synecta/ext-ollama-deepseek-v4.1-flash",
  "small_model": "synecta/ext-ollama-deepseek-v4.1-flash",
  "disabled_providers": ["gitlab", "anthropic"],
  "skills": {
    "paths": [
      "/home/begench/projects/mattpocock-skills/skills"
    ]
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-opencode-slim",
    {
      "package": "/home/begench/projects/configurations/.config/opencode/proxy-model-sync",
      "options": {
        "baseURL": "http://208.92.227.18:8317/v1",
        "providers": [{ "id": "gemini", "family": "gemini" }]
      }
    }
  ],
  "provider": {
    "proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Codex via proxy (cli-proxy-api)",
      "options": {
        "baseURL": "{env:VPS_IP}",
        "apiKey": "{env:VPS_API_KEY}"
      },
      "models": {
        "gpt-6.1-sol": { "name": "GPT-6.1 Sol (proxy)" },
        "gpt-6.1-sol-fast": { "name": "GPT-6.1 Sol Fast (proxy, priority)" },
        "gpt-6-sol-fast": { "name": "GPT-6 Sol Fast (proxy, priority)" },
        "gpt-6.1-terra": { "name": "GPT-6.1 Terra (proxy)" },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra (proxy)" },
        "gpt-6-sol": { "name": "GPT-6 Sol (proxy)" },
        "gpt-6-luna": { "name": "GPT-6 Luna (proxy)" },
        "gpt-6-astra": { "name": "GPT-6 Astra (proxy)" },
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol (proxy)" }
      }
    },
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini via proxy",
      "options": {
        "baseURL": "http://208.92.227.18:8317/v1",
        "apiKey": "{env:VPS_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash"
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite"
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        }
      }
    },
    "synecta": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Synecta Hub",
      "options": {
        "baseURL": "http://10.9.0.2:4000/v1",
        "apiKey": "{env:SYNECTA_API_KEY}"
      },
      "models": {
        "code": {
          "name": "Код · рекомендуемая"
        },
        "ext-ollama-deepseek-v4-pro": {
          "name": "Код · внешний контур · для трудных задач"
        },
        "ext-ollama-deepseek-v4.1-flash": {
          "name": "Код · внешний контур · основная"
        },
        "local-qwen3-coder-strict": {
          "name": "Код · своя нода · бесплатно"
        },
        "ru-mws-gpt-oss-120b": {
          "name": "Код · РФ · экономная"
        },
        "ru-ya-deepseek-v4.1-flash": {
          "name": "Код · РФ · окно 1M"
        },
        "ru-mws-glm-5": {
          "name": "Код · РФ · сильная"
        },
        "ext-ollama-glm-5": {
          "name": "Код · внешний контур · второе мнение"
        },
        "ext-deepseek-v4-pro": {
          "name": "Код · внешний контур · резерв"
        },
        "autocomplete-gigachat": {
          "name": "Автодополнение"
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--executablePath=/usr/bin/chromium"]
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    },
    "jira": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "JIRA_URL",
        "-e",
        "JIRA_PERSONAL_TOKEN",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ],
      "environment": {
        "JIRA_URL": "https://projects.synecta.tech",
        "JIRA_PERSONAL_TOKEN": "{env:JIRA_PERSONAL_TOKEN}"
      }
    },
    "confluence": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "CONFLUENCE_URL",
        "-e",
        "CONFLUENCE_PERSONAL_TOKEN",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ],
      "environment": {
        "CONFLUENCE_URL": "https://wiki.synecta.tech",
        "CONFLUENCE_PERSONAL_TOKEN": "{env:CONFLUENCE_PERSONAL_TOKEN}"
      }
    },
    "gitlab": {
      "type": "local",
      "command": ["glab", "mcp", "serve"],
      "environment": {
        "GITLAB_HOST": "gitlab.synecta.tech",
        "GITLAB_TOKEN": "{env:GITLAB_TOKEN}"
      }
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
