{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "/home/begench/projects/mattpocock-skills/skills"
    ]
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-openagent@beta"
  ],
  "provider": {
    "synecta": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Synecta Hub",
      "options": {
        "baseURL": "https://llm-hub.synecta.tech/v1",
        "apiKey": "{env:SYNECTA_API_KEY}"
      },
      "models": {
        "code": { "name": "Код · рекомендуемая" },
        "ext-ollama-deepseek-v4-pro": { "name": "Код · внешний контур · для трудных задач" },
        "ext-ollama-deepseek-v4.1-flash": { "name": "Код · внешний контур · основная" },
        "local-qwen3-coder-strict": { "name": "Код · своя нода · бесплатно" },
        "ru-mws-gpt-oss-120b": { "name": "Код · РФ · экономная" },
        "ru-ya-deepseek-v4.1-flash": { "name": "Код · РФ · окно 1M" },
        "ru-mws-glm-5": { "name": "Код · РФ · сильная" },
        "ext-ollama-glm-5": { "name": "Код · внешний контур · второе мнение" },
        "ext-deepseek-v4-pro": { "name": "Код · внешний контур · резерв" },
        "autocomplete-gigachat": { "name": "Автодополнение" }
      }
    },
    "anthropic": {
      "name": "Claude via kz",
      "options": {
        "baseURL": "http://46.8.254.240:8317/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-fable-5-1": {
          "options": {
            "thinking": {
              "blockBinding": false
            }
          }
        }
      }
    },
    "openai": {
      "name": "Codex via kz",
      "blacklist": ["gpt-6-astra-pro"],
      "options": {
        "baseURL": "http://46.8.254.240:8317/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini via kz",
      "options": {
        "baseURL": "http://46.8.254.240:8317/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash"
        },
        "gemini-3.6-flash-high": {
          "name": "Gemini 3.6 Flash High"
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite"
        },
        "gemini-3.1-pro-low": {
          "name": "Gemini 3.1 Pro Low"
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "gemini-3.7-flash-high": {
          "name": "Gemini 3.7 Flash High"
        },
        "gemini-pro-agent": {
          "name": "Gemini Pro Agent"
        }
      }
    }
  },
  "mcp": {
    "jira": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm",
                  "-e", "JIRA_URL", "-e", "JIRA_PERSONAL_TOKEN",
                  "ghcr.io/sooperset/mcp-atlassian:latest"],
      "environment": {
        "JIRA_URL": "https://projects.synecta.tech",
        "JIRA_PERSONAL_TOKEN": "{env:JIRA_PERSONAL_TOKEN}"
      }
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--executablePath=/usr/bin/chromium"]
    }
  }
}
