{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "/home/begench/projects/mattpocock-skills/skills"
    ]
  },
  "plugin": ["oh-my-opencode-slim"],
  "provider": {
    "anthropic": {
      "name": "Claude via kz",
      "options": {
        "baseURL": "{env:VPS_IP}",
        "apiKey": "{env:VPS_API_KEY}"
      },
      "models": {
        "claude-fable-5-1": {
          "options": {
            "thinking": {
              "blockBinding": false
            }
          }
        }
      }
    },
    "openai": {
      "name": "Codex via kz",
      "blacklist": ["gpt-6-astra-pro"],
      "options": {
        "baseURL": "{env:VPS_IP}",
        "apiKey": "{env:VPS_API_KEY}"
      }
    },
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini via kz",
      "options": {
        "baseURL": "{env:VPS_IP}",
        "apiKey": "{env:VPS_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash"
        },
        "gemini-3.6-flash-high": {
          "name": "Gemini 3.6 Flash High"
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite"
        },
        "gemini-3.1-pro-low": {
          "name": "Gemini 3.1 Pro Low"
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "gemini-3.7-flash-high": {
          "name": "Gemini 3.7 Flash High"
        },
        "gemini-pro-agent": {
          "name": "Gemini Pro Agent"
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--executablePath=/usr/bin/chromium"]
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
